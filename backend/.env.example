# --- App ---
ENVIRONMENT=development
DEBUG=true
APP_NAME="LMS Backend"

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Database (matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://lms:lms@localhost:5432/lms

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO local) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=lms-uploads

# --- JWT ---
JWT_SECRET=change-me-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ISSUER=lms-backend
JWT_AUDIENCE=lms-clients
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Agent service ---
AGENT_SERVICE_URL=http://localhost:8001
