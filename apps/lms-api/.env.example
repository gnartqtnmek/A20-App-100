# --- App ---
ENVIRONMENT=development
DEBUG=true
APP_NAME="LMS Backend"

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg://lms:lms@localhost:5432/lms

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO local) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=lms-uploads

# --- JWT ---
JWT_SECRET=change-me-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ISSUER=lms-backend
JWT_AUDIENCE=lms-clients
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Agent service ---
AGENT_SERVICE_URL=http://localhost:8001
# Shared secret the Agent uses to call /agent/tools/*.
# Generate with: openssl rand -hex 32
AGENT_SERVICE_TOKEN=dev-agent-token-please-change

# --- Embeddings ---
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# --- LLM (Chat / AI Tutor) ---
# Provider: openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
# Leave blank to use the official OpenAI endpoint
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# --- Mem0 (long-term memory) ---
# Option A: Mem0 cloud (recommended for production)
MEM0_API_KEY=m0-...
MEM0_ORG_ID=your-org-id
MEM0_PROJECT_ID=lms-chatbot
# Option B: Self-hosted (leave MEM0_API_KEY blank and set Qdrant URL)
MEM0_QDRANT_URL=http://localhost:6333

# --- Chat tuning ---
CHAT_HISTORY_WINDOW=20
CHAT_RAG_TOP_K=5
