# ----------------------------------
# Brainio LMS Local Environment
# ----------------------------------

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:3000
JWT_SECRET=brainio-dev-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# PostgreSQL 15
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=brainio
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55432/brainio

# Redis 7
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379/0

# AI prompt logging hooks (used by AGENTS.md workflow)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-your-key
AI_LOG_DIR=.ai-log
