# Choose one or both providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-..
OPENAI_BASE_URL=
LLM_PROVIDER=anthropic

# Default model
DEFAULT_MODEL=claude-sonnet-4-20250514
# DEFAULT_MODEL=gpt-4o
DEFAULT_MAX_TOKENS=4096
MAX_AGENT_STEPS=8

# Logging
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Retrieval / indexing
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
SHORT_TERM_MAX_TURNS=10
SHORT_TERM_RECENT_TURNS=8
SHORT_TERM_MAX_INPUT_TOKENS=12000

# AI Hook Logging (set by instructor)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=lMfm8NPzHVHlOtYx2kOQ7c9PTxJOB0E3DJbD_UBlsFw
AI_LOG_DIR=.ai-log

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=a20db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/a20db?sslmode=disable

# Agent <-> LMS integration
# URL that agent-api uses to call lms-api's /agent/tools/* endpoints
LMS_API_URL=http://lms-api:8000
# Shared secret (min 32 bytes). Generate with: openssl rand -hex 32
AGENT_SERVICE_TOKEN=dev-agent-token-please-change

# LMS API port (exposed on host)
LMS_API_PORT=8001

# LMS Auth (JWT)
JWT_SECRET=change-me-please-use-openssl-rand-hex-32

# Knowledge base embeddings (lms-api uses these for lesson ingestion)
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
